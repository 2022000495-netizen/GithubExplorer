{"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_015sZnArY7uuqiSAH75ZgovA", "content": "1\timport React, { useState, FormEvent, useEffect } from 'react';\n2\timport { FiChevronRight, FiTrash2 } from 'react-icons/fi';\n3\timport { Link } from 'react-router-dom';\n4\t\n5\timport api from '../../services/api';\n6\timport logoImage from '../../assets/logo.svg';\n7\timport Footer from '../../components/Footer';\n8\t\n9\timport { Title, Form, Repositories, Error, RemoveButton } from './styles';\n10\t\n11\tinterface Repository {\n12\t  full_name: string;\n13\t  description: string;\n14\t  owner: {\n15\t    login: string;\n16\t    avatar_url: string;\n17\t  };\n18\t}\n19\t\n20\tconst Home: React.FC = () => {\n21\t  const [newRepo, setNewRepo] = useState('');\n22\t  const [inputError, setInputError] = useState('');\n23\t  const [repositories, setRepositories] = useState<Repository[]>(() => {\n24\t    const storagedRepositories = localStorage.getItem(\n25\t      '@GihubExplorer:repositories',\n26\t    );\n27\t\n28\t    if (storagedRepositories) {\n29\t      return JSON.parse(storagedRepositories);\n30\t    }\n31\t    return [];\n32\t  });\n33\t\n34\t  async function handleAddRepository(\n35\t    event: FormEvent<HTMLFormElement>,\n36\t  ): Promise<void> {\n37\t    event.preventDefault();\n38\t\n39\t    if (!newRepo) {\n40\t      setInputError('Digite o autor/nome do repositório ');\n41\t      return;\n42\t    }\n43\t    try {\n44\t      const response = await api.get<Repository>(`repos/${newRepo}`);\n45\t\n46\t      const repository = response.data;\n47\t\n48\t      setRepositories([...repositories, repository]);\n49\t\n50\t      setNewRepo('');\n51\t\n52\t      setInputError('');\n53\t    } catch (error) {\n54\t      setInputError(\n55\t        'Erro na busca por esse repositório. Verifique o nome/repositório usados.',\n56\t      );\n57\t    }\n58\t  }\n59\t\n60\t  function handleRemoveRepository(fullName: string): void {\n61\t    setRepositories(repositories.filter((repo) => repo.full_name !== fullName));\n62\t  }\n63\t\n64\t  useEffect(() => {\n65\t    localStorage.setItem(\n66\t      '@GihubExplorer:repositories',\n67\t      JSON.stringify(repositories),\n68\t    );\n69\t  }, [repositories]);\n70\t\n71\t  return (\n72\t    <>\n73\t      <img src={logoImage} alt=\"Github Explorer\" />\n74\t      <Title>Explore repositórios no github.</Title>\n75\t\n76\t      <Form hasError={!!inputError} onSubmit={handleAddRepository}>\n77\t        <input\n78\t          value={newRepo}\n79\t          onChange={(e) => setNewRepo(e.target.value)}\n80\t          placeholder=\"Digite o nome do repositório\"\n81\t        />\n82\t        <button type=\"submit\">Pesquisar</button>\n83\t      </Form>\n84\t      {inputError && <Error>{inputError}</Error>}\n85\t\n86\t      <Repositories>\n87\t        {repositories.map((repository) => (\n88\t          <div key={crypto.randomUUID()}>\n89\t            <Link to={`/repositories/${repository.full_name}`}>\n90\t              <img\n91\t                src={repository.owner.avatar_url}\n92\t                alt={repository.owner.login}\n93\t              />\n94\t              <div>\n95\t                <strong>{repository.full_name}</strong>\n96\t                <p>{repository.description}</p>\n97\t              </div>\n98\t              <FiChevronRight size={20} />\n99\t            </Link>\n100\t            <RemoveButton\n101\t              onClick={() => handleRemoveRepository(repository.full_name)}\n102\t              title=\"Remover repositório\"\n103\t            >\n104\t              <FiTrash2 size={20} />\n105\t            </RemoveButton>\n106\t          </div>\n107\t        ))}\n108\t      </Repositories>\n109\t\n110\t      <Footer />\n111\t    </>\n112\t  );\n113\t};\n114\t\n115\texport default Home;\n116\t"}]}}
