er-radius: 5px;\n85\t    width: 100%;\n86\t    padding: 24px;\n87\t    display: block;\n88\t    text-decoration: none;\n89\t    display: flex;\n90\t    align-items: center;\n91\t    transition: transform 0.2s;\n92\t    &:hover {\n93\t      transform: translateX(10px);\n94\t    }\n95\t    & + a {\n96\t      margin-top: 16px;\n97\t    }\n98\t\n99\t    img {\n100\t      width: 64px;\n101\t      height: 64px;\n102\t      border-radius: 50%;\n103\t      @media (max-width: 460px) {\n104\t        display: none;\n105\t      }\n106\t    }\n107\t\n108\t    div {\n109\t      margin: 0px 16px;\n110\t      flex: 1;\n111\t\n112\t      strong {\n113\t        font-size: 20px;\n114\t        color: #3d3d4d;\n115\t      }\n116\t      p {\n117\t        font-size: 18px;\n118\t        color: #a8a8b3;\n119\t        margin-top: 4px;\n120\t      }\n121\t\n122\t      @media (max-width: 600px) {\n123\t        strong,\n124\t        p {\n125\t          font-size: 16px;\n126\t        }\n127\t      }\n128\t    }\n129\t    svg {\n130\t      margin-left: auto;\n131\t      color: #cbcbd6;\n132\t\n133\t      @media (max-width: 350px) {\n134\t        display: none;\n135\t      }\n136\t    }\n137\t  }\n138\t`;\n139\t\n140\texport const Error = styled.span`\n141\t  display: block;\n142\t  color: #c53030;\n143\t  margin-top: 8px;\n144\t`;\n145\t"}]}}
