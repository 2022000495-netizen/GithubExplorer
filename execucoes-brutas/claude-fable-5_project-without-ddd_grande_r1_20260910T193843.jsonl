{"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_01Arvdbi6TQRNXU44qq9ee1T", "content": "1\timport React, { useState, useEffect } from 'react';\n2\timport { Link, useParams } from 'react-router-dom';\n3\timport { FiChevronLeft, FiChevronRight } from 'react-icons/fi';\n4\t\n5\timport api from '../../services/api';\n6\t\n7\timport logoImage from '../../assets/logo.svg';\n8\timport Footer from '../../components/Footer';\n9\t\n10\timport { Header, RespositoryInfo, Issues } from './styles';\n11\t\n12\tinterface Repository {\n13\t  full_name: string;\n14\t  description: string;\n15\t  owner: {\n16\t    login: string;\n17\t    avatar_url: string;\n18\t  };\n19\t  stargazers_count: number;\n20\t  forks_count: number;\n21\t  open_issues_count: number;\n22\t}\n23\tinterface Issue {\n24\t  id: number;\n25\t  title: string;\n26\t  html_url: string;\n27\t  user: {\n28\t    login: string;\n29\t  };\n30\t}\n31\t\n32\tconst Repository: React.FC = () => {\n33\t  const { '*': repositoryName } = useParams();\n34\t  const [repository, setRepository] = useState<Repository | null>(null);\n35\t  const [issues, setIssues] = useState<Issue[]>([]);\n36\t\n37\t  useEffect(() => {\n38\t    api.get(`/repos/${repositoryName}`).then((response) => {\n39\t      setRepository(response.data);\n40\t    });\n41\t    api.get(`/repos/${repositoryName}/issues`).then((response) => {\n42\t      setIssues(response.data);\n43\t    });\n44\t  }, [repositoryName]);\n45\t\n46\t  return (\n47\t    <>\n48\t      <Header>\n49\t        <img src={logoImage} alt=\"Github Explorer\" />\n50\t        <Link to=\"/\">\n51\t          <FiChevronLeft size={16} color=\"#3D3D4D\" />\n52\t          <strong>Voltar</strong>\n53\t        </Link>\n54\t      </Header>\n55\t      {repository ? (\n56\t        <RespositoryInfo>\n57\t          <header>\n58\t            <img src={repository.owner.avatar_url} alt=\"Owner profile avatar\" />\n59\t            <div>\n60\t              <strong>{repository.full_name}</strong>\n61\t              <p>{repository.description}</p>\n62\t            </div>\n63\t          </header>\n64\t          <ul>\n65\t            <li>\n66\t              <strong>{repository.stargazers_count}</strong>\n67\t              <span>Stars</span>\n68\t            </li>\n69\t            <li>\n70\t              <strong>{repository.forks_count}</strong>\n71\t              <span>Forks</span>\n72\t            </li>\n73\t            <li>\n74\t              <strong>{repository.open_issues_count}</strong>\n75\t              <span>Issues abertos</span>\n76\t            </li>\n77\t          </ul>\n78\t        </RespositoryInfo>\n79\t      ) : (\n80\t        <p>Carregando informações.</p>\n81\t      )}\n82\t\n83\t      <Issues>\n84\t        {issues.map((issue) => (\n85\t          <a key={issue.id} href={issue.html_url}>\n86\t            <div>\n87\t              <strong>{issue.title}</strong>\n88\t              <p>{issue.user.login}</p>\n89\t            </div>\n90\t            <FiChevronRight size={20} />\n91\t          </a>\n92\t        ))}\n93\t      </Issues>\n94\t\n95\t      <Footer />\n96\t    </>\n97\t  );\n98\t};\n99\t\n100\texport default Repository;\n101\t"}]}}
