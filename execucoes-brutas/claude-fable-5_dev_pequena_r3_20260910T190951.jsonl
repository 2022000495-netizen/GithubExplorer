{"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_01T7PGCJ7a2MKTkioRUkudZ2", "content": "1\timport React from \"react\";\n2\timport { FiChevronRight } from \"react-icons/fi\";\n3\timport { Link } from \"react-router-dom\";\n4\timport { Repository } from \"@/domain/models/Repository\";\n5\timport { Container } from \"./styles\";\n6\t\n7\tinterface Props {\n8\t  repositories: Repository[];\n9\t}\n10\tconst RepositoriesList: React.FC<Props> = ({ repositories }: Props) => {\n11\t  return (\n12\t    <Container>\n13\t      {repositories.map(({ name, description, owner }) => (\n14\t        <Link key={`${name}`} to={`/repositories/${owner.login}/${name}`}>\n15\t          <img src={owner.avatar} alt={owner.login} />\n16\t          <div>\n17\t            <strong>{name}</strong>\n18\t            <p>{description}</p>\n19\t          </div>\n20\t          <FiChevronRight size={20} />\n21\t        </Link>\n22\t      ))}\n23\t    </Container>\n24\t  );\n25\t};\n26\t\n27\texport default RepositoriesList;\n28\t"}]}}
