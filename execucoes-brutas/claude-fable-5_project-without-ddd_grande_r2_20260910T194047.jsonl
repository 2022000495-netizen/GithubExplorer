{"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_0154YdJWzskJ4mkui1dJpaR8", "content": "1\timport React, { useState, FormEvent, useEffect } from 'react';\n2\timport { FiChevronRight } from 'react-icons/fi';\n3\timport { Link } from 'react-router-dom';\n4\t\n5\timport api from '../../services/api';\n6\timport logoImage from '../../assets/logo.svg';\n7\timport Footer from '../../components/Footer';\n8\t\n9\timport { Title, Form, Repositories, Error } from './styles';\n10\t\n11\tinterface Repository {\n12\t  full_name: string;\n13\t  description: string;\n14\t  owner: {\n15\t    login: string;\n16\t    avatar_url: string;\n17\t  };\n18\t}\n19\t\n20\tconst Home: React.FC = () => {\n21\t  const [newRepo, setNewRepo] = useState('');\n22\t  const [inputError, setInputError] = useState('');\n23\t  const [repositories, setRepositories] = useState<Repository[]>(() => {\n24\t    const storagedRepositories = localStorage.getItem(\n25\t      '@GihubExplorer:repositories',\n26\t    );\n27\t\n28\t    if (storagedRepositories) {\n29\t      return JSON.parse(storagedRepositories);\n30\t    }\n31\t    return [];\n32\t  });\n33\t\n34\t  async function handleAddRepository(\n35\t    event: FormEvent<HTMLFormElement>,\n36\t  ): Promise<void> {\n37\t    event.preventDefault();\n38\t\n39\t    if (!newRepo) {\n40\t      setInputError('Digite o autor/nome do repositório ');\n41\t      return;\n42\t    }\n43\t    try {\n44\t      const response = await api.get<Repository>(`repos/${newRepo}`);\n45\t\n46\t      const repository = response.data;\n47\t\n48\t      setRepositories([...repositories, repository]);\n49\t\n50\t      setNewRepo('');\n51\t\n52\t      setInputError('');\n53\t    } catch (error) {\n54\t      setInputError(\n55\t        'Erro na busca por esse repositório. Verifique o nome/repositório usados.',\n56\t      );\n57\t    }\n58\t  }\n59\t\n60\t  useEffect(() => {\n61\t    localStorage.setItem(\n62\t      '@GihubExplorer:repositories',\n63\t      JSON.stringify(repositories),\n64\t    );\n65\t  }, [repositories]);\n66\t\n67\t  return (\n68\t    <>\n69\t      <img src={logoImage} alt=\"Github Explorer\" />\n70\t      <Title>Explore repositórios no github.</Title>\n71\t\n72\t      <Form hasError={!!inputError} onSubmit={handleAddRepository}>\n73\t        <input\n74\t          value={newRepo}\n75\t          onChange={(e) => setNewRepo(e.target.value)}\n76\t          placeholder=\"Digite o nome do repositório\"\n77\t        />\n78\t        <button type=\"submit\">Pesquisar</button>\n79\t      </Form>\n80\t      {inputError && <Error>{inputError}</Error>}\n81\t\n82\t      <Repositories>\n83\t        {repositories.map((repository) => (\n84\t          <Link key={crypto.randomUUID()} to={`/repositories/${repository.full_name}`}>\n85\t            <img\n86\t              src={repository.owner.avatar_url}\n87\t              alt={repository.owner.login}\n88\t            />\n89\t            <div>\n90\t              <strong>{repository.full_name}</strong>\n91\t              <p>{repository.description}</p>\n92\t            </div>\n93\t            <FiChevronRight size={20} />\n94\t          </Link>\n95\t        ))}\n96\t      </Repositories>\n97\t\n98\t      <Footer />\n99\t    </>\n100\t  );\n101\t};\n102\t\n103\texport default Home;\n104\t"}]}}
